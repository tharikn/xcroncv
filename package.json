{
  "name": "xcroncv",
  "private": true,
  "version": "0.1.0",
  "description": "XCron CV - independent Resume Builder platform (microservice)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm run start:dev -w apps/api",
    "api:build": "npm run build -w apps/api",
    "api:test": "npm run test -w apps/api",
    "db:migrate": "npm run prisma:migrate -w apps/api",
    "web:dev": "npm run start -w apps/web",
    "web:build": "npm run build -w apps/web",
    "web:test": "npm run test -w apps/web",
    "e2e": "npm run e2e -w apps/web",
    "test": "npm run api:test && npm run web:test"
  }
}
