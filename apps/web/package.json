{
  "name": "@xcroncv/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "node scripts/dev.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "cap:sync": "ng build --configuration development && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "build:dev": "ng build --configuration development",
    "serve:static": "node scripts/serve.mjs",
    "ng:serve": "ng serve --port 4200"
  },
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@ionic/angular": "^8.3.0",
    "ionicons": "^7.4.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular/cli": "^17.3.17",
    "@angular/compiler-cli": "^17.3.0",
    "@axe-core/playwright": "^4.10.0",
    "@capacitor/cli": "^6.1.0",
    "@playwright/test": "^1.48.0",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.2.0",
    "typescript": "~5.4.2"
  }
}
