# apps/api/.env (copy from here)
NODE_ENV=development
PORT=3100
DATABASE_URL=postgresql://xcroncv:xcroncv@localhost:5433/xcron
DB_SCHEMA=xcroncv
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost,http://127.0.0.1,https://localhost,capacitor://localhost
# Auth: production uses the X Cron OIDC issuer JWKS (set AUTH_JWKS_URL). Leave it unset locally: JWKS takes precedence over AUTH_DEV_SECRET.
AUTH_ISSUER=https://xcron.example.com
AUTH_AUDIENCE=xcroncv
# AUTH_JWKS_URL=https://xcron.example.com/.well-known/jwks.json
AUTH_TENANT_CLAIM=tenant_id
# Local development ONLY (ignored when NODE_ENV=production)
AUTH_DEV_SECRET=change-me-dev-only-secret-at-least-32-chars
# Optional modules (docs 42, 46, 48). Comma list to switch off: cover-letters,crm,job-analytics
FEATURES_DISABLED=
# Encrypts contact notes (module 46). Required in production; use 32+ random chars.
NOTES_ENCRYPTION_KEY=change-me-dev-only-notes-key-32-chars-min
# Credential identifier encryption (module 49). Required in production; a dev-only fallback is used otherwise.
CREDENTIAL_ENCRYPTION_KEY=

# Platform modules (AI gateway, webhooks)
# AI_PROVIDER=deterministic   # or none
# AI_DAILY_LIMIT=20
# AI_TIMEOUT_MS=8000
# WEBHOOK_ENCRYPTION_KEY=     # required in production

# In-app assistant (floating help chat, docs 06/38).
# Guided answers are deterministic and always available; the external provider is used only when
# the user turned AI on in /ai, so leaving these unset never breaks the widget.
# AI_HELP_ENABLED=true
# AI_HELP_PROVIDER=groq            # groq | openai | ollama (unset = guided answers only)
# AI_HELP_API_KEY=
# AI_HELP_BASE_URL=                # defaults per provider (ollama: http://localhost:11434/v1)
# AI_HELP_MODEL=                   # defaults per provider
# AI_HELP_DAILY_TOKEN_BUDGET=4000  # per user per UTC day, enforced from AiUsageEvent
# AI_HELP_COOLDOWN_MS=8000
# AI_HELP_MAX_MESSAGE_CHARS=500
# AI_HELP_MAX_HISTORY_TURNS=4
# AI_HELP_MAX_COMPLETION_TOKENS=220
# AI_HELP_TIMEOUT_MS=20000
# AI_HELP_COST_PER_1K_MICROS=0     # metering only; never affects quota maths

# Host (X Cron) handoff. The CV API exchanges one-time codes with the host server-to-server.
# HOST_HANDOFF_URL=https://x-cron-api.onrender.com
# HOST_HANDOFF_SECRET=   # must equal the host HANDOFF_EXCHANGE_SECRET
